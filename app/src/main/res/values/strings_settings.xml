    <!-- 权限引导页 -->
    <string name="perm_title">权限引导</string>
    <string name="perm_intro">权限不阻塞主流程：被拒绝时自动走降级路径。从系统设置返回后，状态会自动刷新。</string>
    <string name="perm_granted">已授予</string>
    <string name="perm_denied">未授予</string>
    <string name="perm_declared">已声明</string>
    <string name="perm_action_settings">去设置</string>
    <string name="perm_action_request">允许</string>
    <string name="perm_notifications_title">通知</string>
    <string name="perm_notifications_desc">用于计时中的常驻通知和停止按钮。拒绝后计时仍可用，但通知栏没有入口，锁屏时不易停止。</string>
    <string name="perm_notification_granted">通知权限已授予</string>
    <string name="perm_notification_denied">通知权限被拒：计时仍可用，但不再有常驻通知</string>
    <string name="perm_exact_alarm_title">精确闹钟</string>
    <string name="perm_exact_alarm_desc">用于小部件在后台按分钟级刷新。拒绝后刷新降级为不精确唤醒（约 15 分钟一次），时长仍按开始时间计算。</string>
    <string name="perm_overlay_title">悬浮窗</string>
    <string name="perm_overlay_desc">为桌面滑动提示预留（P1 才使用）。拒绝后不影响当前计时与记录。</string>
    <string name="perm_battery_title">电池优化白名单</string>
    <string name="perm_battery_desc">避免长时间计时被系统冻结。拒绝后后台刷新与通知可能延迟，重新打开 App 后时长会自动校正。</string>
    <string name="perm_nfc_title">NFC</string>
    <string name="perm_nfc_desc">用于碰触标签开始或停止计时；这一项是系统 NFC 开关状态，不是运行时权限。关闭后碰标签不会触发计时。</string>
    <string name="perm_nfc_no_hardware">本机未检测到 NFC 硬件，相关功能不可用。</string>
    <string name="perm_fgs_title">前台服务（specialUse）</string>
    <string name="perm_fgs_desc">已在清单声明，无运行时开关。计时期间以前台服务保持时长准确并刷新小部件。</string>
    <string name="perm_open_failed">无法打开系统设置页</string>

