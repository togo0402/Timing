<?xml version="1.0" encoding="utf-8"?>
<!-- W1 2×2：Canvas 圆角渐变卡片 + 秒表环（ImageView），环中央叠真实 TextView + Chronometer -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_timer_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/widget_timer_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_timer_card_desc" />

    <LinearLayout
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <TextView
            android:id="@+id/widget_timer_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="@string/widget_timer_idle_title"
            android:textColor="#FF101828"
            android:textSize="13sp"
            android:textStyle="bold" />

        <Chronometer
            android:id="@+id/widget_timer_chrono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:fontFeatureSettings="tnum"
            android:textColor="#FF101828"
            android:textSize="21sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/widget_timer_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:text="@string/widget_timer_idle_hint"
            android:textColor="#99101828"
            android:textSize="9sp" />
    </LinearLayout>
</FrameLayout>
